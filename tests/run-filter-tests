#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "$0")/.." && pwd)"
: "${IDF_PATH:?Set IDF_PATH to the ESP-IDF checkout used for the firmware}"
test_dir="$(mktemp -d)"
trap 'rm -rf "$test_dir"' EXIT

"${CC:-cc}" -std=c11 -Wall -Wextra -Werror -g \
    -fsanitize=address,undefined,float-cast-overflow \
    -fno-sanitize-recover=all \
    -I "$repo_dir/components/microlink/include" \
    -I "$IDF_PATH/components/json/cJSON" \
    "$repo_dir/tests/filter_test.c" \
    "$repo_dir/components/microlink/src/ml_filter.c" \
    "$IDF_PATH/components/json/cJSON/cJSON.c" \
    -lm -o "$test_dir/filter-test"
"$test_dir/filter-test"
