#!/usr/bin/env bash
set -euo pipefail
repo_dir="$(cd "$(dirname "$0")/.." && pwd)"
test_dir="$(mktemp -d)"
trap 'rm -rf "$test_dir"' EXIT
"${CC:-cc}" -std=c11 -Wall -Wextra -Werror -g -pthread \
    -fsanitize=address,undefined -fno-sanitize-recover=all \
    -I "$repo_dir/tests/wireguard_stubs" -I "$repo_dir/components/wireguard_lwip/src" \
    "$repo_dir/tests/timestamp_test.c" "$repo_dir/components/wireguard_lwip/src/wireguard-timestamp.c" \
    -o "$test_dir/timestamp-test"
"$test_dir/timestamp-test"
