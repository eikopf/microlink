#!/usr/bin/env bash
set -euo pipefail
repo_dir="$(cd "$(dirname "$0")/.." && pwd)"
test_dir="$(mktemp -d)"
trap 'rm -rf "$test_dir"' EXIT
"${CC:-cc}" -std=c11 -Wall -Wextra -Werror -g -include endian.h \
    -fsanitize=address,undefined -fno-sanitize-recover=all \
    -I "$repo_dir/tests/nodekey_stubs" \
    -I "$repo_dir/components/microlink/include" \
    -I "$repo_dir/components/microlink/src" \
    "$repo_dir/tests/nodekey_test.c" \
    "$repo_dir/components/microlink/src/ml_nodekey.c" \
    "$repo_dir/components/microlink/src/ml_x25519.c" \
    -o "$test_dir/nodekey-test"
"$test_dir/nodekey-test"
